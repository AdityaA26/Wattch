# Copy to person4/.env for local use. Never commit real credentials.
# Run python3 -m person4.configure_key for hidden key entry.
GEMINI_API_KEY=
# Leave blank for automatic text Flash model discovery.
GEMINI_MODEL=
# Optional TigerData URI; blank uses local SQLite.
DATABASE_URL=
PORT=8000
# The built frontend's own origin is accepted automatically.
FRONTEND_ORIGIN=
